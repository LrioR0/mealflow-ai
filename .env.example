APP_ENV=development
APP_NAME=MealFlow API
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./data/local/mealflow.sqlite3
CORS_ORIGINS=http://localhost:5173

# V1 uses cloud APIs only. qwen is primary; deepseek is the fallback provider.
LLM_PROVIDER=qwen
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
AGENT_MAX_STEPS=12

KIOSK_TOKEN_SECRET=replace-in-real-environment
DEMO_MODE=true
