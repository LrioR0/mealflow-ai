APP_ENV=development
APP_NAME=MealFlow API
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./data/local/mealflow.sqlite3
CORS_ORIGINS=http://localhost:5173

# V1 uses cloud APIs only. Keep real keys in OS environment variables or an ignored .env.
LLM_PROVIDER=deepseek
LLM_API_STYLE=chat_completions
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=30
AGENT_MAX_STEPS=6

DEMO_MODE=true
